<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Per-user LaunchAgent for `updraft start`.
  install-launchagent.sh fills the __PLACEHOLDERS__ (XML-escaped) and writes the result to
  ~/Library/LaunchAgents/<label>.plist. To fill it by hand, use absolute paths everywhere:
  launchd does not expand ~ or $VARS and gives agents a minimal PATH.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- node runs the installed package's dist/cli.js directly; no npm shim or shell. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__CLI__</string>
    <string>start</string>
    <string>--config</string>
    <string>__CONFIG__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__WORKDIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <!--__EXTRA_ENV__-->
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart after a crash or non-zero exit; a clean exit (exit code 0) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/launchd.err.log</string>
</dict>
</plist>
