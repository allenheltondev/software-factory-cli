# Build settings for the MicroVM image, read by the Dockerfile's RUN steps (POSIX sh syntax).
#
# CreateMicrovmImage has no build-argument input, so `docker build --build-arg` has no
# equivalent there. deploy.sh writes a copy of this file into the build context with values
# from its environment (NODE_VERSION, UPDRAFT_SPEC, AGENT_PACKAGES); edit the defaults here.

# Node.js release to install from nodejs.org (Updraft needs >= 22.13).
NODE_VERSION="22.23.5"

# npm spec of Updraft. Ignored when vendor/ contains an `npm pack` tarball (*.tgz).
UPDRAFT_SPEC="@allenheltondev/updraft@0.1.0"

# Agent CLIs to install with npm, space-separated. Claude Code by default; for example
# "@anthropic-ai/claude-code @openai/codex" to add Codex. Pin versions for repeatable builds.
AGENT_PACKAGES="@anthropic-ai/claude-code"
