{
  "name": "@allenheltondev/updraft",
  "version": "0.1.0",
  "description": "CLI that watches your GitHub repos and dispatches labeled issues to coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allenheltondev/software-factory-cli.git"
  },
  "type": "module",
  "bin": {
    "updraft": "dist/cli.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config/public.d.ts",
      "default": "./dist/config/public.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-telemetry.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.0"
  }
}
