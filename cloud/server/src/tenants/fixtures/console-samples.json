        "docs": {
          "label": "docs",
          "pool": "fast",
          "prompt": "# Write the docs",
          "review": {
            "enabled": true,
            "pool": "reviewers",
            "prompt": "# Review the docs",
            "allowSameAgent": false,
            "acceptance": "report"
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise the docs",
            "maxRevisions": 4
          }
        },
        "chore": {
          "label": "chore",
          "pool": "fast",
          "prompt": "# Do the chore",
          "timeoutMinutes": 15,
          "review": {
            "enabled": true,
            "pool": "reviewers",
            "prompt": "# Review the chore",
