            "waitMinutes": 30
          },
          "ci": {
            "checks": [
              "build"
            ],
            "ignore": [
              "preview"
            ]
          }
        },
        "acme/api": {
          "enabled": false,
          "workflows": [
            "implement"
          ],
          "publish": "draft-pr",
          "commentOnFailure": true,
          "verify": []
        }
      },
      "legacy": {
        "pools": {
          "implement": "builders",
          "implement.review": "reviewers"
        },
        "workflows": {
          "implement": "implement"
        }
      }
    }
  },
