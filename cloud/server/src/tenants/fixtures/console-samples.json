{
  "$comment": "Console settings as published by the configuration page (#193), shared by the server's round-trip tests (config-service.test.ts) and the page's (app/src/pages/config.test.tsx). Installation 55 reaches acme/web and acme/api and has the Claude and Codex keys.",
  "samples": {
    "simple": {
      "version": 2,
      "agents": {
        "claude": {
          "adapter": "claude",
          "enabled": true
        },
        "codex": {
          "adapter": "codex",
          "enabled": true
        }
      },
      "pools": {
        "builders": {
          "agents": [
            "claude",
            "codex"
          ]
        },
        "reviewers": {
          "agents": [
            "claude",
            "codex"
          ]
        }
      },
      "allowedActors": [
        "pat"
      ],
      "workflows": {
        "implement": {
          "label": "updraft",
          "pool": "builders",
          "prompt": "# Implement the issue",
          "review": {
            "enabled": true,
            "pool": "reviewers",
            "prompt": "# Review the PR",
            "allowSameAgent": false
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise the PR"
          }
        }
      },
      "repositories": {
        "acme/web": {
          "enabled": true,
          "workflows": [
            "implement"
          ],
          "publish": "draft-pr",
          "commentOnFailure": true,
          "verify": []
        }
      }
    },
    "labels": {
      "version": 2,
      "agents": {
        "claude": {
          "adapter": "claude",
          "model": "claude-opus-5-5",
          "effort": "high",
          "enabled": true
        },
        "codex": {
          "adapter": "codex",
          "effort": "medium",
          "enabled": true
        }
      },
      "pools": {
        "builders": {
          "agents": [
            "claude",
            "codex"
          ]
        },
        "reviewers": {
          "agents": [
            "claude",
            "codex"
          ]
        },
        "art-coding": {
          "agents": [
            "codex"
          ]
        },
        "art-review": {
          "agents": [
            "claude"
          ]
        },
        "implement-api-coding": {
          "agents": [
            "claude"
          ]
        },
        "implement-api-review": {
          "agents": [
            "codex"
          ]
        }
      },
      "allowedActors": [
        "pat",
        "sam"
      ],
      "workflows": {
        "implement": {
          "label": "ready",
          "pool": "builders",
          "prompt": "# Implement the issue, our way",
          "timeoutMinutes": 45,
          "review": {
            "enabled": true,
            "pool": "reviewers",
            "prompt": "# Review against our style guide",
            "allowSameAgent": false,
            "acceptance": "enforce"
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise, keeping the diff small",
            "maxRevisions": 2
          }
        },
        "art": {
          "label": "art",
          "pool": "art-coding",
          "prompt": "# Draw the assets the issue asks for",
          "review": {
            "enabled": true,
            "pool": "art-review",
            "prompt": "# Review the assets",
            "allowSameAgent": false,
            "acceptance": "enforce"
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise the assets",
            "maxRevisions": 2
          }
        },
        "docs": {
          "label": "docs",
          "pool": "builders",
          "prompt": "# Write the docs",
          "review": {
            "enabled": true,
            "pool": "reviewers",
            "prompt": "# Review the docs",
            "allowSameAgent": false,
            "acceptance": "enforce"
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise the docs",
            "maxRevisions": 2
          }
        },
        "implement-api": {
          "label": "ready",
          "pool": "implement-api-coding",
          "prompt": "# Implement the issue, our way",
          "timeoutMinutes": 45,
          "review": {
            "enabled": true,
            "pool": "implement-api-review",
            "prompt": "# Review against our style guide",
            "allowSameAgent": false,
            "acceptance": "enforce"
          },
          "revise": {
            "enabled": true,
            "prompt": "# Revise, keeping the diff small",
            "maxRevisions": 2
          }
        }
      },
      "repositories": {
        "acme/web": {
          "enabled": true,
          "workflows": [
            "implement",
            "art",
            "docs"
          ],
          "allowedActors": [
            "sam"
          ],
          "publish": "pr",
          "commentOnFailure": true,
          "verify": [
            "npm ci",
            "npm test"
          ],
          "verifyTimeoutMinutes": 20,
          "autoMerge": {
            "method": "squash",
            "requiredChecks": [
              "test"
            ]
          },
          "ci": {}
        },
        "acme/api": {
          "enabled": true,
          "workflows": [
            "implement-api",
            "art"
          ],
          "baseBranch": "dev",
          "publish": "draft-pr",
          "commentOnFailure": false,
          "verify": [
            "make test"
          ],
          "notifications": "verbose",
          "suggestions": "follow-up"
        }
      }
    },
