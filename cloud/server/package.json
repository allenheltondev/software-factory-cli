{
  "name": "@updraft-cloud/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Updraft Cloud API: a Hono app behind API Gateway (REST) with a Cognito authorizer",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tenant-admin": "tsx scripts/tenant-admin.ts",
    "build-job-image": "tsx scripts/build-job-image.ts",
    "claude-session-trace": "tsx scripts/claude-session-trace.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1175.0",
    "@aws-sdk/client-dynamodb": "^3.1172.0",
    "@aws-sdk/client-eventbridge": "^3.1176.0",
    "@aws-sdk/client-lambda": "^3.1175.0",
    "@aws-sdk/client-lambda-microvms": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1172.0",
    "@aws-sdk/client-ssm": "^3.1172.0",
    "@aws-sdk/client-sts": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1172.0",
    "hono": "^4.13.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1173.0",
    "@hono/node-server": "^2.1.1",
    "@types/aws-lambda": "^8.10.160",
    "aws-jwt-verify": "^5.2.1",
    "tsx": "^4.23.15"
  }
}
